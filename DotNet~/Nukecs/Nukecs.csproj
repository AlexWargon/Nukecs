<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine-independent core (src/ without src/Unity/) built without Unity.
       Unity ignores folders ending in '~', so this project never enters the Unity build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Nukecs</AssemblyName>
    <RootNamespace>Wargon.Nukecs</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Warnings of the Unity code base that the Unity build does not report either. -->
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\**\*.cs" Exclude="..\..\src\Unity\**" />
    <Analyzer Include="..\..\SourceGen\NUKECSGEN.dll" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>
</Project>
